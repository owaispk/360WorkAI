@page "/admin/security"
@inherits AdminPage
@using System.Text.Json

<PageTitle>Security · Platform admin · OpenWork Cloud</PageTitle>

<section class="den-card den-wide" data-testid="admin-security-page">
    @if (Loading)
    {
        <p class="den-muted">Loading…</p>
    }
    else if (Denied)
    {
        <h1>Security</h1>
        <p class="den-muted" data-testid="no-access">This area is for the people who run this deployment. Your account is not one of them.</p>
    }
    else
    {
        <h1>Security</h1>
        <AdminNav Current="security" />
        <p class="den-muted">Signals about accounts, credentials and use. Each one states the rule that raised it. They are prompts for review, not verdicts, and nothing here changes an account.</p>
        @if (Error is not null) { <p class="den-error" role="alert" data-testid="error">@Error</p> }
        <div class="den-inline" data-testid="days">
            @foreach (var d in new[] { 7, 14, 30 })
            {
                <button type="button" class="den-link @(_days == d ? "current" : "")" disabled="@Busy" @onclick="() => ChooseAsync(d)" data-testid="days-@d">Last @d days</button>
            }
        </div>
        @foreach (var f in _findings)
        {
            <div class="den-panel" data-testid="finding" data-id="@f.Id" data-severity="@f.Severity">
                <strong>@f.Title <span class="den-badge @(f.Severity is "high" or "medium" ? "den-badge-pending" : "den-badge-admin")" data-testid="severity">@f.Severity</span></strong>
                <p data-testid="summary">@f.Summary</p>
                @if (f.Entities.Count > 0)
                {
                    <ul class="den-members">
                        @foreach (var e in f.Entities) { <li data-testid="entity"><strong>@e.Label</strong><span class="den-muted">@e.Detail</span><span class="den-badge">@e.Severity</span></li> }
                    </ul>
                    @if (f.EntityCount > f.Entities.Count) { <p class="den-muted">and @(f.EntityCount - f.Entities.Count) more</p> }
                }
                <details>
                    <summary>How this is decided</summary>
                    <p class="den-muted" data-testid="rule">@f.Rule</p>
                    <p class="den-muted">@f.Why</p>
                    <p class="den-muted">@f.Review</p>
                </details>
            </div>
        }

        <h2>Refused and failed requests</h2>
        <p class="den-muted">The last 24 hours of sign-in, token and app-registration refusals, stale credentials and rate limits. The log keeps no addresses, people or credentials: only which route, what happened and when.</p>
        @if (_requests is { } r)
        {
            <div class="admin-tiles" data-testid="request-totals">
                <div class="admin-tile" data-testid="requests-refused"><span class="admin-tile-value">@r.Refused</span><span class="den-muted">Refused</span></div>
                <div class="admin-tile" data-testid="requests-limited"><span class="admin-tile-value">@r.RateLimited</span><span class="den-muted">Rate-limited</span></div>
                <div class="admin-tile" data-testid="requests-failed"><span class="admin-tile-value">@r.Failed</span><span class="den-muted">Failed</span></div>
                <div class="admin-tile" data-testid="requests-sign-ins"><span class="admin-tile-value">@r.FailedSignIns</span><span class="den-muted">Failed sign-ins</span></div>
            </div>
            @if (r.Endpoints.Count == 0)
            {
                <p class="den-muted" data-testid="no-requests">No refused or failed requests in the last 24 hours.</p>
            }
            else
            {
                <table class="den-table" data-testid="request-endpoints">
                    <thead><tr><th>Route</th><th>Refused</th><th>Rate-limited</th><th>Failed</th><th>Busiest hour</th></tr></thead>
                    <tbody>
                        @foreach (var e in r.Endpoints)
                        {
                            <tr data-testid="request-endpoint" data-action="@e.Action"><td><code>@e.Action</code></td><td>@e.Refused</td><td>@e.RateLimited</td><td>@e.Failed</td><td>@e.Peak</td></tr>
                        }
                    </tbody>
                </table>
            }
            @foreach (var f in r.Findings.Where(f => f.Severity != "clear"))
            {
                <div class="den-panel" data-testid="request-finding" data-id="@f.Id" data-severity="@f.Severity">
                    <strong>@f.Title <span class="den-badge den-badge-pending">@f.Severity</span></strong>
                    <p>@f.Summary</p>
                    <p class="den-muted">@f.Rule</p>
                </div>
            }
        }
    }
</section>

@code {
    private sealed record Entity(string Label, string Detail, string Severity);
    private sealed record Finding(string Id, string Title, string Severity, string Summary, string Rule, string Why, string Review, int EntityCount, List<Entity> Entities);

    private int _days = 7;
    private List<Finding> _findings = [];
    private sealed record RequestEndpoint(string Action, int Refused, int RateLimited, int Failed, int Peak);
    private sealed record Requests(int Refused, int RateLimited, int Failed, int FailedSignIns, List<RequestEndpoint> Endpoints, List<Finding> Findings);
    private Requests? _requests;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        if (!await EnterAsync()) return;
        await LoadAsync();
        Loading = false;
        StateHasChanged();
    }

    protected override async Task ReloadAsync() => await LoadAsync();

    private async Task ChooseAsync(int days)
    {
        _days = days;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var response = await Den.RequestAsync($"/api/browser/v1/admin/security?days={_days}");
        if (response.Json is not { ValueKind: JsonValueKind.Object } root) { Error = response.Message("Could not load the security signals."); return; }
        Error = null;
        _findings = root.GetProperty("findings").EnumerateArray().Select(f => new Finding(Text(f, "id"), Text(f, "title"), Text(f, "severity"), Text(f, "summary"), Text(f, "rule"), Text(f, "why"), Text(f, "review"), Number(f, "entityCount"),
            f.GetProperty("entities").EnumerateArray().Select(e => new Entity(Text(e, "label"), Text(e, "detail"), Text(e, "severity"))).ToList())).ToList();

        var requests = await Den.RequestAsync("/api/browser/v1/admin/security/requests");
        if (requests.Json is { ValueKind: JsonValueKind.Object } q && requests.Ok)
        {
            var hourly = q.GetProperty("hourly").EnumerateArray().ToList();
            _requests = new Requests(hourly.Sum(h => Number(h, "refused")), hourly.Sum(h => Number(h, "rateLimited")), hourly.Sum(h => Number(h, "failed")), hourly.Sum(h => Number(h, "failedSignIns")),
                q.GetProperty("endpoints").EnumerateArray().Select(e => new RequestEndpoint(Text(e, "action"), Number(e, "refused"), Number(e, "rateLimited"), Number(e, "failed"), Number(e, "peakHour"))).ToList(),
                q.GetProperty("findings").EnumerateArray().Select(f => new Finding(Text(f, "id"), Text(f, "title"), Text(f, "severity"), Text(f, "summary"), Text(f, "rule"), Text(f, "why"), Text(f, "review"), Number(f, "entityCount"), [])).ToList());
        }
    }
}
