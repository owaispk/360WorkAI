@page "/reset-password"
@inject DenClient Den
@inject NavigationManager Nav

<PageTitle>Choose a new password · OpenWork Cloud</PageTitle>

<section class="den-card" data-testid="reset-password">
    @if (_state == State.Done)
    {
        <h1>Password changed.</h1>
        <p class="den-muted" data-testid="reset-done">Sign in with your new password. You were signed out everywhere else.</p>
        <a class="den-button" href="/">Sign in</a>
    }
    else if (_state == State.Invalid)
    {
        <h1>This reset link is not valid.</h1>
        <p class="den-muted" data-testid="reset-invalid">It may have expired or already been used. Request a new link from the sign-in page.</p>
        <a class="den-button den-secondary" href="/">Back to sign in</a>
    }
    else
    {
        <h1>Choose a new password.</h1>
        <p class="den-muted">Use the reset link from your email to secure your OpenWork account.</p>
        <form @onsubmit="SubmitAsync">
            <label for="new-password">New password</label>
            <input id="new-password" type="password" autocomplete="new-password" @bind="_password" @bind:event="oninput" />
            <label for="confirm-password">Confirm new password</label>
            <input id="confirm-password" type="password" autocomplete="new-password" @bind="_confirm" @bind:event="oninput" />
            @if (_error is not null) { <p class="den-error" role="alert">@_error</p> }
            <button type="submit" class="den-button" disabled="@_busy">Reset password</button>
        </form>
    }
</section>

@code {
    private enum State { Form, Invalid, Done }

    private State _state = State.Form;
    private string _token = "";
    private string _password = "";
    private string _confirm = "";
    private string? _error;
    private bool _busy;

    protected override void OnInitialized()
    {
        var query = System.Web.HttpUtility.ParseQueryString(new Uri(Nav.Uri).Query);
        _token = query["token"] ?? "";
        if (string.IsNullOrEmpty(_token) || !string.IsNullOrEmpty(query["error"])) _state = State.Invalid;
    }

    private async Task SubmitAsync()
    {
        _error = null;
        if (_password != _confirm) { _error = "Passwords do not match."; return; }
        _busy = true;
        var result = await Den.RequestAsync("/api/auth/reset-password", "POST", new { newPassword = _password, token = _token });
        _busy = false;
        if (result.Ok) { _password = _confirm = ""; _state = State.Done; return; }
        if (result.String("code") == "INVALID_TOKEN") { _state = State.Invalid; return; }
        _error = result.Message("Could not reset the password. Try again."); // the server's message names the rule that was broken
    }
}
