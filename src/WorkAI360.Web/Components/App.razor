<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["WorkAI360.Web.styles.css"]" />
    <ImportMap />
    <HeadOutlet @rendermode="Mode" />
</head>

<body>
    <Routes @rendermode="Mode" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    // No server prerender: the pages read the session through the browser (cookies), which only exists after the circuit starts.
    private static readonly IComponentRenderMode Mode = new InteractiveServerRenderMode(prerender: false);
}
