<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Ed25519 (EdDSA) for client assertions and DPoP proofs; already in the graph through MailKit, referenced directly because the code uses it. -->
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <PackageReference Include="Jint" Version="4.17.0" />
    <PackageReference Include="MailKit" Version="4.18.2" />
    <PackageReference Include="Zxcvbn-Core" Version="7.0.92" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14" PrivateAssets="all" />
    <PackageReference Include="MySql.EntityFrameworkCore" Version="10.0.12" />
  </ItemGroup>

</Project>
