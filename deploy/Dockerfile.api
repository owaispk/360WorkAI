# The API. Build from the 360workai directory:  docker build -f deploy/Dockerfile.api -t workai360-api .
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY Directory.Build.props WorkAI360.slnx ./
COPY src/WorkAI360.Api/WorkAI360.Api.csproj src/WorkAI360.Api/
RUN dotnet restore src/WorkAI360.Api/WorkAI360.Api.csproj
COPY src/WorkAI360.Api src/WorkAI360.Api
RUN dotnet publish src/WorkAI360.Api/WorkAI360.Api.csproj -c Release -o /out --no-restore

FROM mcr.microsoft.com/dotnet/aspnet:10.0
WORKDIR /app
COPY --from=build /out .
# Run as an unprivileged user.
RUN useradd --system --uid 10001 --no-create-home app && chown -R app /app
USER app
ENV ASPNETCORE_URLS=http://+:8080 ASPNETCORE_ENVIRONMENT=Production Database__Provider=mysql
EXPOSE 8080
HEALTHCHECK --interval=15s --timeout=3s --start-period=20s CMD ["dotnet", "WorkAI360.Api.dll", "--healthcheck"]
ENTRYPOINT ["dotnet", "WorkAI360.Api.dll"]
